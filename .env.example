# ============================================================
# SGA SaaS - Variables de entorno de ejemplo
# Copiar como .env en producción/desarrollo y ajustar valores
# NUNCA subir el archivo .env real a GitHub
# ============================================================

# ----------------------------
# Aplicación
# ----------------------------
APP_NAME=SGA_SAAS
APP_ENV=production
DEBUG=false

# ----------------------------
# Backend / FastAPI
# ----------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ----------------------------
# Base de datos PostgreSQL
# Para Docker local:
# DATABASE_URL=postgresql://sga_user:sga_password@postgres:5432/sga_db
#
# Para VPS/producción ajustar usuario, clave, host y base:
# DATABASE_URL=postgresql://usuario:password@host:5432/base_datos
# ----------------------------
DATABASE_URL=postgresql://sga_user:sga_password@postgres:5432/sga_db

# ----------------------------
# Seguridad JWT
# Cambiar SECRET_KEY en producción por una clave larga y segura
# ----------------------------
SECRET_KEY=CAMBIAR_ESTA_CLAVE_EN_PRODUCCION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------
# Frontend
# En desarrollo:
# VITE_API_URL=http://127.0.0.1:8000
#
# En producción:
# VITE_API_URL=https://api.tudominio.com
# o
# VITE_API_URL=https://tudominio.com/api
# ----------------------------
VITE_API_URL=http://127.0.0.1:8000

# ----------------------------
# Archivos / Evidencias
# ----------------------------
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=20

# ----------------------------
# CORS producción
# Ajustar con el dominio real del cliente
# ----------------------------
CORS_ORIGINS=https://sga-holding.com,https://www.sga-holding.com