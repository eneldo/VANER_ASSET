# VANER ASSET - Environment Configuration Example
# Copy this file to .env and replace every CAMBIAR_* value.

APP_NAME=VANER ASSET
APP_VERSION=2.0.0
CLIENT_CODE=local
CLIENT_NAME=Entorno local
APP_DOMAIN=localhost
APP_ENV=development
DEBUG=false
PROJECT_DIR=/opt/vaner_asset

IMAGE_TAG=latest
BACKEND_IMAGE=vanstralhen/vaner-asset-backend
FRONTEND_IMAGE=vanstralhen/vaner-asset-frontend
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7.4.2-alpine
CADDY_IMAGE=caddy:2.10.0-alpine

HOST=127.0.0.1
PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

POSTGRES_DB=vaner_asset
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_PROPIETARIO
POSTGRES_APP_PASSWORD=CAMBIAR_PASSWORD_APLICACION
POSTGRES_BACKUP_PASSWORD=CAMBIAR_PASSWORD_BACKUP
DATABASE_URL=postgresql://sga_app:CAMBIAR_PASSWORD_APLICACION@postgres:5432/vaner_asset
MIGRATION_DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD_PROPIETARIO@postgres:5432/vaner_asset
BACKUP_DATABASE_URL=postgresql://sga_backup:CAMBIAR_PASSWORD_BACKUP@postgres:5432/vaner_asset

REDIS_PASSWORD=CAMBIAR_PASSWORD_REDIS
REDIS_URL=redis://:CAMBIAR_PASSWORD_REDIS@redis:6379/0
RATE_LIMIT_REDIS_REQUIRED=true

SECRET_KEY=CAMBIAR_CLAVE_ALEATORIA_MINIMO_32_CARACTERES
CONFIG_ENCRYPTION_KEY=CAMBIAR_CLAVE_FERNET_BASE64
BACKUP_ENCRYPTION_REQUIRED=true
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=vaner_asset_refresh_token
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

VITE_API_URL=/api
FRONTEND_URL=http://localhost:8080
BACKEND_CORS_ORIGINS=http://localhost:8080
BOOTSTRAP_ADMIN_TOKEN=

UPLOAD_DIR=/app/uploads
BACKUP_DIR=/app/backups
MAX_UPLOAD_SIZE_MB=20
MAX_INVENTORY_IMPORT_MB=10
MAX_INVENTORY_IMPORT_ROWS=10000

S3_BACKUP_ENABLED=false
S3_BACKUP_ENDPOINT_URL=
S3_BACKUP_REGION=auto
S3_BACKUP_BUCKET=
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=
S3_BACKUP_PREFIX=vaner-asset-production

RUN_MIGRATIONS=false
RUN_SCHEDULER=false
ALLOW_DATABASE_RESTORE=false
