# ============================================================
# SGA SaaS - Variables de entorno de ejemplo
# Copiar como .env en producción/desarrollo y ajustar valores
# NUNCA subir el archivo .env real a GitHub
# ============================================================

# ----------------------------
# Aplicación
# ----------------------------
APP_NAME=SGA_SAAS
APP_ENV=production
DEBUG=false

# Imagenes publicadas por CI. En produccion use el SHA completo del commit.
IMAGE_TAG=CAMBIAR_SHA_GIT_PUBLICADO
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7.4.2-alpine
CADDY_IMAGE=caddy:2.10.0-alpine

# ----------------------------
# Backend / FastAPI
# ----------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ----------------------------
# Base de datos PostgreSQL
# Para Docker local:
# DATABASE_URL=postgresql://sga_user:sga_password@postgres:5432/sga_db
#
# Para VPS/producción ajustar usuario, clave, host y base:
# DATABASE_URL=postgresql://usuario:password@host:5432/base_datos
# ----------------------------
POSTGRES_DB=sga_db
POSTGRES_USER=sga_owner
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_PROPIETARIO
POSTGRES_APP_PASSWORD=CAMBIAR_PASSWORD_APLICACION
POSTGRES_BACKUP_PASSWORD=CAMBIAR_PASSWORD_BACKUP

DATABASE_URL=postgresql://sga_app:CAMBIAR_PASSWORD_APLICACION@postgres:5432/sga_db
BACKUP_DATABASE_URL=postgresql://sga_backup:CAMBIAR_PASSWORD_BACKUP@postgres:5432/sga_db
# Exclusiva para Alembic/DDL; nunca debe usarla el proceso web.
MIGRATION_DATABASE_URL=postgresql://sga_owner:CAMBIAR_PASSWORD_PROPIETARIO@postgres:5432/sga_db

# Rate limiting distribuido
REDIS_PASSWORD=CAMBIAR_PASSWORD_REDIS
REDIS_URL=redis://:CAMBIAR_PASSWORD_REDIS@redis:6379/0
RATE_LIMIT_REDIS_REQUIRED=true

# ----------------------------
# Seguridad JWT
# Cambiar SECRET_KEY en producción por una clave larga y segura
# ----------------------------
SECRET_KEY=CAMBIAR_ESTA_CLAVE_EN_PRODUCCION
CONFIG_ENCRYPTION_KEY=CAMBIAR_CLAVE_FERNET_BASE64
BACKUP_ENCRYPTION_REQUIRED=true
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=sga_refresh_token
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

# ----------------------------
# Frontend
# En producción se recomienda usar el proxy del mismo dominio.
# ----------------------------
VITE_API_URL=/api
FRONTEND_URL=https://sgaholding.online

# Opcional: habilita temporalmente el endpoint oculto de bootstrap.
# Se recomienda usar el comando CLI documentado y dejar este valor vacio.
BOOTSTRAP_ADMIN_TOKEN=

# ----------------------------
# Archivos / Evidencias
# ----------------------------
UPLOAD_DIR=/app/uploads
BACKUP_DIR=/app/backups
MAX_UPLOAD_SIZE_MB=20
MAX_INVENTORY_IMPORT_MB=10
MAX_INVENTORY_IMPORT_ROWS=10000

# Segunda copia obligatoria en S3/R2 para produccion.
S3_BACKUP_ENABLED=true
S3_BACKUP_ENDPOINT_URL=CAMBIAR_ENDPOINT_S3_R2
S3_BACKUP_REGION=auto
S3_BACKUP_BUCKET=CAMBIAR_BUCKET_BACKUPS
S3_BACKUP_ACCESS_KEY_ID=CAMBIAR_ACCESS_KEY_BACKUPS
S3_BACKUP_SECRET_ACCESS_KEY=CAMBIAR_SECRET_KEY_BACKUPS
S3_BACKUP_PREFIX=sga-production

# ----------------------------
# CORS producción
# Ajustar con el dominio real del cliente
# ----------------------------
BACKEND_CORS_ORIGINS=https://sgaholding.online

# ----------------------------
# Operación
# ----------------------------
RUN_MIGRATIONS=false
RUN_SCHEDULER=true
ALLOW_DATABASE_RESTORE=false
